config/dev.local.env
config/prod.env

# 日志
*.log
logs/

# 本地上传文件（STORAGE_DRIVER=local 时落 services/api/uploads）
services/api/uploads/

# 系统与 IDE 文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 测试与临时产物
test-results/
playwright-report/
*.tsbuildinfo
