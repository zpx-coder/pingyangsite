{
  "name": "pingyang-api",
  "version": "0.1.0",
  "private": true,
  "description": "平阳产业带官网后端 API（NestJS + Prisma，MySQL 5.6.16 / Redis 7.0.15）",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@prisma/client": "^6.0.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-redis": "^10.0.0",
    "express-session": "^1.19.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!**/*.module.ts",
      "!config/**",
      "!**/*.types.ts",
      "!**/*.interface.ts",
      "!prisma/prisma.service.ts",
      "!storage/ali-oss.d.ts",
      "!upload/multer.d.ts",
      "!test-utils/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "statements": 80,
        "branches": 70
      }
    },
    "moduleNameMapper": {
      "^@nestjs/common$": "<rootDir>/test-utils/nest-common.mock.ts",
      "^@nestjs/platform-express$": "<rootDir>/test-utils/platform-express.mock.ts",
      "^@nestjs/config$": "<rootDir>/test-utils/config.mock.ts"
    }
  }
}
