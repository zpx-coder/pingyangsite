# 后端环境变量模板（复制为 .env 使用；真实值不入库）
# 本地默认值见 config/dev.local.env（scripts/dev-up.sh 自动生成）

# MySQL 5.6.16 适配约定：连接串显式指定 utf8mb4
DATABASE_URL="mysql://pingyang:pingyang123456@127.0.0.1:3306/pingyangsite?character_set=utf8mb4"

# 种子数据（仅本地开发用默认值，生产经环境变量注入）
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=Admin@123456
