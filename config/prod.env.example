# 生产环境配置模板（部署时复制为 config/prod.env 并填写真实值）
# 安全底线：真实密钥一律经服务器环境变量注入，本模板只提交占位符
# （.gitignore 已忽略 .env*，仅 *.example 入库）

# 数据库（生产为自建 MySQL 5.6.16，仅内网访问）
DB_HOST=<填写：生产 MySQL 内网地址>
DB_PORT=3306
DB_NAME=pingyangsite
DB_USER=<填写>
DB_PASSWORD=<填写>

# 缓存（生产 Redis 7.0.15）
REDIS_HOST=<填写>
REDIS_PORT=6379
REDIS_PASSWORD=<填写>

# 服务端会话签名（随机长字符串，泄露须立即更换）
SESSION_SECRET=<填写：随机 64 位字符串>

# 存储与翻译隔离开关（本地联调用 local/mock，生产用 oss/real）
STORAGE_DRIVER=oss
MT_MODE=real

# 阿里云 OSS + CDN（生产填写；STORAGE_DRIVER=oss 时四要素缺失拒绝启动）
OSS_REGION=<填写>
OSS_BUCKET=<填写>
OSS_ACCESS_KEY_ID=<填写>
OSS_ACCESS_KEY_SECRET=<填写>
# 可选：内网/自定义 Endpoint（默认 oss-<region>.aliyuncs.com）
# OSS_ENDPOINT=<填写>
# 可选：CDN 加速域名（配置后公开地址走 CDN，缩略图 = URL + x-oss-process 按需裁剪）
# OSS_CDN_DOMAIN=<填写>

# 阿里云机器翻译（生产填写）
ALIYUN_MT_ACCESS_KEY_ID=<填写>
ALIYUN_MT_ACCESS_KEY_SECRET=<填写>

# ===== 官网站点侧注入（部署 frontend/site 时作为 Next.js 环境变量，任务 5.2/5.4）=====
# 后端公开 API 地址：Next 服务端（SSR/ISR/中间件 404 预检）直连该地址，
# 用内网地址即可（无需公网可达），如 http://api-internal:3001
API_BASE_URL=<填写>
# 站点公开域名（含协议，不带尾斜杠）：用于 SEO canonical 与 sitemap 地址
SITE_URL=<填写>
