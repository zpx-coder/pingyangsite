# 本地开发环境配置模板（复制为 config/dev.local.env 使用，由 scripts/dev-up.sh 自动生成）
# 仅用于本地 Docker 基础设施，均为默认开发值，可在本地随意修改；禁止填入生产密钥

COMPOSE_PROJECT_NAME=pingyangsite
MYSQL_PORT=3306
REDIS_PORT=6379

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=pingyangsite
MYSQL_USER=pingyang
MYSQL_PASSWORD=pingyang123456

# 存储驱动（本地默认 local：文件落 services/api/uploads，/uploads 静态服务；
# 切 oss 需同时填 OSS_* 四变量，见 config/prod.env.example）
STORAGE_DRIVER=local
# 入库公开地址前缀（本地默认 http://127.0.0.1:3001，一般无需修改）
# STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3001

# 翻译模式（本地默认 mock：不消耗阿里云配额；切 real 需填 ALIYUN_MT_*）
MT_MODE=mock
# ALIYUN_MT_ACCESS_KEY_ID=
# ALIYUN_MT_ACCESS_KEY_SECRET=
